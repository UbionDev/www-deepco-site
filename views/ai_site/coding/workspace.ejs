    //* check import module
    var getDefaultImportModule = function() {
        var defaultImportModule = "";
        if(workspace.getBlocksByType('led_check').length > 0
         || workspace.getBlocksByType('led_ready').length > 0
         || workspace.getBlocksByType('led_by_pin').length > 0
         || workspace.getBlocksByType('led_select_on').length > 0
         || workspace.getBlocksByType('led_select_off').length > 0
         || workspace.getBlocksByType('led_blink_advance').length > 0
        ) { 
          defaultImportModule += "from gpiozero import LED \r\n";
          defaultImportModule += "led17 = None\r\nled10 = None\r\nled9 = None\r\nled11 = None\r\n";
          defaultImportModule += "led17 = LED(17)\r\nled10 = LED(10)\r\nled9 = LED(9)\r\nled11 = LED(11)\r\n";
        }
        if(workspace.getBlocksByType('PWMled_ready').length > 0
          || workspace.getBlocksByType('PWMled_blink_advance').length > 0)
        { 
          defaultImportModule += "from gpiozero import PWMLED \r\n";
          defaultImportModule += "led17 = None\r\nled10 = None\r\nled9 = None\r\nled11 = None\r\n";
          defaultImportModule += "led17 = PWMLED(17, frequency=100)\r\nled10 = PWMLED(10, frequency=100)\r\nled9 = PWMLED(9, frequency=100)\r\nled11 = PWMLED(11, frequency=100)\r\n";
        }
        if(workspace.getBlocksByType('RGBled_on').length > 0
          || workspace.getBlocksByType('RGBled_off').length > 0
          || workspace.getBlocksByType('RGBled_blink_advance').length > 0)
        { 
          defaultImportModule += "from gpiozero import RGBLED \r\n";
          defaultImportModule += "led = None\r\n";
          defaultImportModule += "led = RGBLED(2, 3, 4)\r\n";
        }
        if(workspace.getBlocksByType('button_ready').length > 0
        || workspace.getBlocksByType('button_ispressed').length > 0)
        { 
          defaultImportModule += "from gpiozero import Button \r\n";
          defaultImportModule += "button = None\r\n"; 
          defaultImportModule += "button = Button(15)\r\n";
        }
        if(workspace.getBlocksByType('buzzer_ready').length > 0
          || workspace.getBlocksByType('buzzer_on').length > 0
          || workspace.getBlocksByType('buzzer_off').length > 0
          || workspace.getBlocksByType('buzzer_beep_advance').length > 0)
        { 
          defaultImportModule += "from gpiozero import Buzzer \r\n"; 
          defaultImportModule += "buzzer = None\r\n"; 
          defaultImportModule += "buzzer = Buzzer(18)\r\n"; 
        }
        if(workspace.getBlocksByType('dcsensor_ready').length > 0
          ||workspace.getBlocksByType('distance').length > 0)
        { 
          defaultImportModule += "from gpiozero import DistanceSensor \r\n"; 
          defaultImportModule += "from gpiozero.pins.pigpio import PiGPIOFactory \r\n";
          defaultImportModule += 'factory = None\r\n';
          defaultImportModule += 'factory = PiGPIOFactory()\r\n';
          defaultImportModule += 'ds = None\r\n';
          defaultImportModule += 'ds = DistanceSensor(27,22, pin_factory=factory)\r\n';
        }
        if(workspace.getBlocksByType('gpio_by_num').length > 0)
        {   defaultImportModule += "import RPi.GPIO as GPIO \r\n";
            defaultImportModule += "GPIO.setmode(GPIO.BCM) \r\n\n"; }
        if(workspace.getBlocksByType('keyboard_control').length > 0)
        { defaultImportModule += "import curses \r\n"; }
        if(workspace.getBlocksByType('motor_ready').length > 0
          || workspace.getBlocksByType('motor_ready_advance').length > 0 
         || workspace.getBlocksByType('motor_speed').length > 0
         || workspace.getBlocksByType('set_motor_forward').length > 0
         || workspace.getBlocksByType('set_motor_backward').length > 0
         || workspace.getBlocksByType('set_motor_stop').length > 0
         || workspace.getBlocksByType('set_motor_forward_advenced').length > 0
         || workspace.getBlocksByType('set_motor_backward_advenced').length > 0)
        { 
          defaultImportModule += "from gpiozero import Motor \r\n";
