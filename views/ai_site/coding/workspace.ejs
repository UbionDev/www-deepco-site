        { 
          defaultImportModule += "import ttsHelper as tts \r\n";
          defaultImportModule += "soundCtrl = tts.SoundController()\r\n";
        }
        if(workspace.getBlocksByType('set_curses_ready').length > 0)
        { defaultImportModule += "import curses \r\n"; }
        if(workspace.getBlocksByType('camera_ready').length > 0
          || workspace.getBlocksByType('set_image_take_picture').length > 0
          || workspace.getBlocksByType('save_image_to_file').length > 0
          || workspace.getBlocksByType('save_image_to_project_file').length > 0
          || workspace.getBlocksByType('camera_end').length > 0)
        { 
          defaultImportModule += "import cameralib as camera \r\n"; 
          defaultImportModule += "import cv2 \r\n"
          defaultImportModule += "import os \r\n"
          defaultImportModule += "cam = camera.Camera()\r\n";
        }
        if(workspace.getBlocksByType('image_resize').length > 0
          || workspace.getBlocksByType('load_data_labeling').length > 0
          ) { defaultImportModule += "import ai_data_lib as dataLib \r\n" }
          if(workspace.getBlocksByType('model_set_with_input').length > 0
          || workspace.getBlocksByType('model_add_conv2d').length > 0
          || workspace.getBlocksByType('model_add_dense').length > 0
          || workspace.getBlocksByType('model_add_flatten').length > 0
          || workspace.getBlocksByType('model_compile_fn').length > 0
          || workspace.getBlocksByType('model_fit_fn').length > 0
          ) { defaultImportModule += "import tensorflow as tf \r\n" 
            defaultImportModule += "from tensorflow.keras.layers import * \r\n" }
              if(workspace.getBlocksByType('x_train_img_fn').length > 0
          ) { defaultImportModule += "import matplotlib.pyplot as plt \r\n" 
          }
              if(workspace.getBlocksByType('model_predict_fn').length > 0
              || workspace.getBlocksByType('model_predict_fn2').length > 0
              || workspace.getBlocksByType('model_predict_fn3').length > 0
          ) { defaultImportModule += "import numpy as np \r\n"
                  //defaultImportModule += "from keras.preprocessing import image \r\n" 
                  defaultImportModule += "import matplotlib.pyplot as plt \r\n"
          }
          if(workspace.getBlocksByType('shuffle').length > 0
          ) { defaultImportModule += "import numpy as np \r\n"
                  defaultImportModule += "import random \r\n" 
          }
          if(workspace.getBlocksByType('model_load').length > 0
          ) { defaultImportModule += "import ai_data_lib2 as dataLib2 \r\n"
            defaultImportModule += "import tensorflow as tf \r\n" 
            defaultImportModule += "from tensorflow.keras.layers import * \r\n"
          }
          if(workspace.getBlocksByType('load_model_predict').length > 0){
            defaultImportModule += "import numpy as np \r\n"
            defaultImportModule += "import ai_data_lib as dataLib \r\n"
          }
          if(workspace.getBlocksByType('wait').length > 0){
            defaultImportModule += "import time \r\n"
          }
          if(workspace.getBlocksByType('image_resize2').length > 0 
          || workspace.getBlocksByType('load_data').length > 0 
          || workspace.getBlocksByType('shuffle_data').length > 0 
          || workspace.getBlocksByType('model_save').length > 0 
          ){
            defaultImportModule += "import ai_data_lib2 as dataLib2 \r\n"
          }
          if(workspace.getBlocksByType('Keyboard_input').length > 0){
            defaultImportModule += "import curses \r\n"
            defaultImportModule += "from curses import wrapper \r\n"
          }

          if(workspace.getBlocksByType('servo_ready').length > 0
          || workspace.getBlocksByType('set_servo_left').length > 0 
          || workspace.getBlocksByType('set_servo_right').length > 0 
          || workspace.getBlocksByType('set_servo_middle').length > 0 
          || workspace.getBlocksByType('set_servo_left_advance').length > 0  
          || workspace.getBlocksByType('set_servo_right_advance').length > 0) 
          {
            //defaultImportModule += "middle = "+parseInt( $('#kit_servo_middle').val() )+" \r\n";
            defaultImportModule += "import json \r\n"
            defaultImportModule += "kit_middle = 0 \r\n";
            defaultImportModule += 'jsonfile = open(\'/home/pi/wifi-scan/kitinfo.json\') \n';
            defaultImportModule += 'jsonstr = json.load(jsonfile) \n';
            defaultImportModule += 'kit_middle = jsonstr.get(\'servo_angle\') \n';
            defaultImportModule += 'kit_middle = int(kit_middle) \n';
          }
          defaultImportModule += 'def RunCode(): \n';
         
        return defaultImportModule;
    }
