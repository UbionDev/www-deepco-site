    // webssh2 서버에서 보내는 메시지 수신용
    // 해당 서버에서 넘어오는 메시지를 확인해 해당 함수 실행
    window.addEventListener('message', function(e) {
        //console.log(e.data);
        var splitDataArr = e.data.split('|');
        var termCmd = '', termIdx = '', imgRootFolderName = '', jsonText = '';
        if( splitDataArr && splitDataArr.length > 1 ) {
            termCmd = splitDataArr[0];
            termIdx = splitDataArr[1];
            imgRootFolderName = splitDataArr[2];
            jsonText = splitDataArr[3];
        }/*
        if( termCmd == 'buildPy' ) {
            buildPythonCode(termIdx);
        }//*/
        if( termCmd == 'killPy' ) {
            initializeToTerminal(termIdx);
            connectToTerminal(termIdx);
        }
        if( termCmd == 'takePictures' ) {
            getPicturesOfCamera(termIdx, 'cam');
        }
        if( termCmd == 'dataPictures' ) {
            getPicturesOfCamera(termIdx, 'training', jsonText);
        }
        if( termCmd == 'imShow' ) {
            imShowPictures(termIdx, 'runimg');
        }

        if( termCmd == 'takeResultPictures' ) {
            getPicturesOfCamera(0, 'result');
        }

        if( termCmd == 'result' ) {
            $('#pictureViewer').find('div.modal-body').find('div.container-fluid').empty();

            console.log(termIdx.replace(/^\s+|\s+$/gm,''));
            console.log(imgRootFolderName);

            drawResultPictures('cam', termIdx.replace(/^\s+|\s+$/gm,''));
            drawResultPictures('result', imgRootFolderName);
        }
        if(termCmd == 'folderlist'){

            for(var i = 1; i < splitDataArr.length; i++){
                var addtext = `<option>${splitDataArr[i]}</option>`
    
                $("#folderList").append(addtext);
            }

        }
        if( termCmd == 'programEnd' ) {
            toggleRunButton();
        }
        

    });

