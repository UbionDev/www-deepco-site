    var getPicturesOfCamera = function(index, pictureFolderName, jsonText) {

        var termFrm = $('#termFrm'+index);

        var param = {
            pictures_folder : pictureFolderName
        }

        
        // scp 전송 준비 폴더 초기화
        initSyncData(pictureFolderName, jsonText);
        // scp 전송 시작
        var termCmd = '';
        var sendInfoObj = {};
        if(pictureFolderName == 'cam') {
            sendInfoObj = {
                filepath: "/home/pi/autonomousCar/block/cam/",
                filename: "picture1.jpg"
            };
            termCmd += 'scpFromKitToWeb|0|'+JSON.stringify(sendInfoObj);
        }
        if(pictureFolderName == 'result') {
