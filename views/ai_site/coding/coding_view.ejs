    // 사진 영역에 이미지 보이기 (수집용)
    var drawPictures = function(index, pictureFolderName, data) {
        var termFrm = $('#termFrm'+index);
        var pic_div = $('#pictureViewer').find('div.modal-body').find('div.container-fluid');
        pic_div.empty();
        data.forEach(function(element){
            var img_url = '<%=host_protocol %>://<%=host_domain %>';  // http://192.168.50.1:3000
            if(pictureFolderName == 'cam') { img_url += '/cam'; }
            else if(pictureFolderName == 'training') { img_url += '/data/training'; }
            else if(pictureFolderName == 'result') { img_url += '/result/cam'; }
            else { img_url += '/img/runimg'; }
            img_url += '/' + element;
            pic_div.append(`<img class="img-fluid mb-1  me-1" src="${img_url}" />`);
        });
        //$('#pictureViewer').show();
        $('#imgshowBtn').trigger('click');
    }

