    //* 코딩 저장/초기화 dataset
    var setSlideDataList = function(slideIndex, procFlag) {
        var curCodingZone = $('li.carousel-item').eq(slideIndex).find('article.explain-zone');
        var curCodingHtml = curCodingZone.html();

        var saveHtml = `<article class="explain-zone">
            ${curCodingHtml}
            </article>`;

        var saveCodingDesc = '';
        var content_sub_item = $('input[name=content_sub]').eq(slideIndex);
        if(procFlag == 'Save') {
            //console.log(saveHtml);
            saveCodingDesc = Base64.encode(saveHtml);
            content_sub_item.data('subCoding', saveCodingDesc);
        } else {
            content_sub_item.data('subCoding', null);
        }

        var contentDescList = [];
        $('input[name=content_sub]').each(function(idx){
            //console.log(idx, $(this).data('subSeq'));
            var subContentObj = {};
            subContentObj.sub_seq = $(this).data('subSeq');
            subContentObj.sub_question = $(this).data('subQuestion');
            subContentObj.sub_desc = $(this).val();
            if(idx == slideIndex) { subContentObj.sub_coding_desc = saveCodingDesc; }
            else { subContentObj.sub_coding_desc = $(this).data('subCoding'); }
            contentDescList.push(subContentObj);
        });
        return contentDescList;
    }
