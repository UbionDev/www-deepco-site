            sendInfoObj = {
                filepath: "/home/pi/autonomousCar/block/data/training",
                targetpath: "/home/pi/autonomousCar/block/data/<%=JSON.parse(tempLoginInfo).loginId %>/training"
            };
            termCmd += 'scpDirFromKitToWeb|0|'+JSON.stringify(sendInfoObj);
        }
        scpFromKitToWeb(index, termCmd);
        // scp 전송 상태 체크
