
<input type="hidden" id="projectId" data-project_name="<%=project_name %>" value="<%=project_id %>">
<input type="hidden" id="contentId" value="<%=content_id %>">

<!-- Page Wrapper -->
<div id="wrapper">

    <!-- Topbar -->
    <nav class="navbar navbar-dark navbar-expand-lg topbar static-top">
        <h1 class="navbar-brand">
          <a href="/home" class="rounded-circle text-white ms-3">
            <i class="logo"></i>
            <span class="visually-hidden">CODE AI</span>
          </a>
          <span class="navbar-brand-text changetitle" data-bs-toggle="tooltip" data-bs-placement="left" title="클릭하여 수정">
            <input type="text" id="inProjectName" value="<%=project_name %>" minlength="1" maxlength="20">
          </span>
        </h1>
        <div class="container-fluid bg-transparent">
        </div>
    </nav>
    <!-- //Topbar -->

    <div id="split-wrapper">

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="container-fluid p-0 ">
            <%
            let contentCnt = 0;
            if(content_desc_list && content_desc_list.length > 0) { contentCnt = content_desc_list.length; }
            %>
            <button type="button" class="btn btn-sm" id="add-tab" data-bs-toggle="tooltip" data-bs-placement="right" title="탭 추가" tabcnt="<%=contentCnt %>">
                <i class="bi bi-plus-lg"></i>
                <span class="visually-hidden">Tab 추가</span>
            </button>

            <select id="folderList" style="display: none;">
                <option value="empty">Empty</option>
            </select>

            <!-- 블록코딩 영역 -->
            <div class="nav nav-tabs border-0" id="titleTabList" role="tablist">
                <%
                if(content_desc_list && content_desc_list.length > 0) {
                    for( let idx in content_desc_list ){
                        let contentItem = content_desc_list[idx];
                        let tabClass = "nav-link";
                        if(idx == 0) { tabClass += " active"; }
                %>
                <a class="<%=tabClass %>" href="#tab<%=idx %>-panel" id="tab<%=idx %>" navindex="<%=idx %>" data-bs-toggle="tab" data-bs-target="#tab<%=idx %>-panel" role="tab" aria-controls="tab<%=idx %>-panel" title="제목없음 선택됨">
                    <span class="changetitle">
                        <input type="text" id="subtitle<%=idx %>" value="제목없음" minlength="1" maxlength="20">
                    </span>
                    <button type="button" class="border-0 cls_rm_tab" id="btnRemoveTab<%=idx %>" tabindex="<%=idx %>" title="제목없음 탭 삭제 "><i class="bi bi-x"></i></button>
                </a>
                <%
                    }
                } else {
                %>
                <a class="nav-link active" href="#tab0-panel" id="tab0" navindex="0" data-bs-toggle="tab" data-bs-target="#tab0-panel" role="tab" aria-controls="tab0-panel" title="제목없음 선택됨">
                    <span class="changetitle">
                        <input type="text" id="subtitle0" value="제목없음" minlength="1" maxlength="20">
                    </span>
                    <button type="button" class="border-0 cls_rm_tab" id="btnRemoveTab0" tabindex="0" title="제목없음 탭 삭제 "><i class="bi bi-x"></i></button>
                </a>
                <%
                }
                %>
            </div>
            <div class="tab-content px-0" id="contentTabList">
                <%
                if(content_desc_list && content_desc_list.length > 0) {
                    for( let idx in content_desc_list ){
                        let contentItem = content_desc_list[idx];
                        let tabClass = "tab-pane";
                        if(idx == 0) { tabClass += " text-white fade show active"; }
                %>
                <div class="<%=tabClass %>" id="tab<%=idx %>-panel" aria-labelledby="tab<%=idx %>" role="tabpanel">
                    <!-- 코딩실습 영역 -->
                    <section class="codingview" id="editor<%=idx %>">

                        <div class="editor_wrap">
                            <article class="explain-zone">
                                <iframe src="/mycoding/workspace2?index=<%=idx %>" width="100%" height="100%" frameborder="0"></iframe>
                            </article>
                            <article class="run-zone" style="display:none;">
                                <textarea id="code<%=idx %>" name="code<%=idx %>"></textarea>
                            </article>
                        </div>
                        
                    </section>
                    <!-- //코딩실습 영역 -->
                </div>
                <input type="hidden" id="content_sub<%=idx %>" name="content_sub" contindex="<%=idx %>" 
                    data-sub-seq="<%=contentItem.sub_seq %>" 
                    data-sub-title="<%=contentItem.sub_title %>"
                    value="<%=contentItem.sub_content_desc %>" />
                <%
                    }
                } else {
                %>
                <div class="tab-pane text-white fade show active" id="tab0-panel" aria-labelledby="tab0" role="tabpanel">
                    <!-- 코딩실습 영역 -->
                    <section class="codingview" id="editor0">
        
                        <div class="editor_wrap">
                            <article class="explain-zone">
                                <iframe src="/mycoding/workspace2?index=0" width="100%" height="100%" frameborder="0"></iframe>
                            </article>
                            <article class="run-zone" style="display:none;">
                                <textarea id="code0" name="code0"></textarea>
                            </article>
                        </div>
                        
                    </section>
                    <!-- //코딩실습 영역 -->
                </div>
                <input type="hidden" id="content_sub0" name="content_sub" contindex="0" 
                    data-sub-seq="1" 
                    data-sub-title="제목없음" 
                    value="" />
                <%
                }
                %>
            </div>
            <!--// 블록코딩 영역 -->

        </div>
        <!-- //Content Wrapper -->

        <!-- 콘솔 영역 -->
        <div id="consolSection" class="container-fluid p-0">
            <div class="btn-group d-block text-right">
                <button type="button" class="reset btn btn-sm text-white" id="initShellBtn" title="콘솔초기화"><i class="bi bi-arrow-repeat"></i><span class="visually-hidden">초기화</span></button>
                <!--<button type="button" class="fix btn btn-sm text-white" title="콘솔고정"><i class="bi bi-pin-angle"></i><span class="visually-hidden">고정</span></button>-->
                <button type="button" class="open btn btn-sm text-white" id="openShellBtn" title="콘솔열림"><i class="bi bi-chevron-up"></i><span class="visually-hidden">콘솔영역</span></button>
            </div>
            <div class="iframeWrap type_webssh">
                <iframe id="termFrm0" src="http://192.168.215.22:2222/ssh/host/192.168.215.22?index=0&referer=<%=host_protocol %>://<%=host_domain %>/" width="100%" height="100%" frameborder="0"></iframe>
            </div>
        </div>
        <!-- //콘솔 영역 -->

    </div>

</div>
<!-- //Page Wrapper -->



<input type="hidden" id="take_picture_yn" value="N" />
<input type="hidden" id="driving_picture_yn" value="N" />
<input type="hidden" id="save_npz_yn" value="N" />
<input type="hidden" id="save_model_yn" value="N" />
<input type="hidden" id="save_pltshow_yn" value="N" />

<!--tempLayer Popup Wrapper-->
