    //* 코딩 저장/초기화 dataset
    var setTabDataList = function(tabIndex, procFlag) {
        var curCodingZone = $('#editor'+tabIndex).find('div.editor_wrap article.explain-zone');
        var curCodingHtml = curCodingZone.html();

        var saveHtml = `<article class="explain-zone">
            ${curCodingHtml}
            </article>`;

        var saveCodingDesc = '';
        if(procFlag == 'Save') {
            //console.log(saveHtml);
            saveCodingDesc = Base64.encode(saveHtml);
        }
        $('#content_sub'+tabIndex).val(saveCodingDesc);

        var contentDescList = [];
        $('input[name=content_sub]').each(function(idx){
            //console.log(idx, $(this).data('subSeq'));
            var content_idx = $(this).attr('contindex');
            var subContentObj = {};
            subContentObj.sub_seq = $(this).data('subSeq');
            subContentObj.sub_title = $('#subtitle'+content_idx).val();
            if(content_idx == tabIndex) { subContentObj.sub_content_desc = saveCodingDesc; }
            else { subContentObj.sub_content_desc = $(this).val(); }
            contentDescList.push(subContentObj);
        });
        return contentDescList;
    }
