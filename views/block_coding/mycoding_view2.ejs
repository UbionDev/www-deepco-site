    <iframe id="termFrmTemp" src="http://192.168.215.22:2222/ssh/host/192.168.215.22?referer=<%=host_protocol %>://<%=host_domain %>/" width="100%" height="100%" frameborder="0"></iframe>
    <iframe id="kitFrmApi" src="http://192.168.215.22/projects/callApi" style="display: none;" width="100%" height="100%" frameborder="0"></iframe>
</div>
<!--//tempLayer Popup Wrapper-->

<script> 

    var projectDescList = [];

    // 어드민페이지에서 생성한 블록 화면에 추가
    var blocksToCode = function (editIndex, wrCode, xmlDom) {
        $("#code" + editIndex).val(wrCode);
        var xmlDomElem = $(xmlDom);
        var xmlText = '<xml xmlns="https://developers.google.com/blockly/xml" id="coding_block_'+editIndex+'" style="display: none">';
            xmlText += xmlDomElem.html() + '</xml>';
            //console.log( xmlText );
        //$("#xml_block_" + editIndex).remove();
        $("#coding_block_" + editIndex).remove();
        $('div.editor_wrap').eq(editIndex).find('article.explain-zone').append( xmlText );
    }

    var setCameraPictures = function(editIndex, cameraYN) {
        //var cameraTagText = '<input type="hidden" id="camera_'+editIndex+'" value="'+cameraYN+'" />';
        $('#take_picture_yn').val(cameraYN);
    }

    var setDrivingPictures = function(editIndex, recordYN) {
        //var drivingTagText = '<input type="hidden" id="driving_'+editIndex+'" value="'+recordYN+'" />';
        $('#driving_picture_yn').val(recordYN);
    }

    var setSaveNpz = function(editIndex, saveNpzYN, saveNpzName) {
        //var saveNpzTagText = '<input type="hidden" id="save_npz_'+editIndex+'" value="'+saveNpzYN+'" />';
        //console.log(editIndex, saveNpzYN, saveNpzName);
        $('#save_npz_yn').val(saveNpzYN).data('save_name', saveNpzName);
    }

    var setSaveModel = function(editIndex, saveModelYN, saveModelName) {
        //var saveModelTagText = '<input type="hidden" id="save_model_'+editIndex+'" value="'+saveModelYN+'" />';
        //console.log(editIndex, saveModelYN, saveModelName);
        $('#save_model_yn').val(saveModelYN).data('save_name', saveModelName);
    }


    var childKit;
    var projectMngPopupShow = function() {

        var kitPop = window.open("http://kit.ubion.co.kr/project/manageview", "kitPop", "_blank");

        childKit = new ByPassCORS(kitPop);
        childKit = getEventListener(childKit);
        
    }

    var imageUploadPopupShow = function() {
        var url = "http://kit.ubion.co.kr/common/img/uploadview";		
        var title = "imgUpload";
        var status = "toolbar=no,scrollbars=no,resizable=yes,status=no,menubar=no,width=800, height=700, top=0,left=0"; 
        var imgPop = window.open(url, title, "_blank");

        childKit = new ByPassCORS(imgPop);
        childKit = getEventListener(childKit);
        
    }

    var copyCodeToClipBoard = function(editIndex) {
        var copyElem = document.getElementById('code' + editIndex);
        var tempTextArea = document.createElement("textarea");
        document.body.appendChild(tempTextArea);
        tempTextArea.value = copyElem.value;
        tempTextArea.select();
        document.execCommand('copy');
        document.body.removeChild(tempTextArea);
        alert('Code Copied.');
    }

    var msgData = {};

    /*
        ssh2 서버 호출 흐름

        - 실행시킬 명령을 coding_view.ejs 에서 약속된 메세지로 webssh2-main/app/client/src/js/index.ts에 전송함
        - index.ts 에 window.addEventListener('message', function(e) 부분에서 메세지를 전송받음
        - 받은 메세지 내용을 가지고 index.ts에서 구분된 함수 실행
        - 실행된 함수는 webssh2-main/app/server/socket.js 에 실행시킬 메세지를 socket.emit 을 통해 전송
        - socket.js에서 socket.on('control', (controlData) =>  부분에서 실행시킬 메세지를 전송받음 
        - 받은 메세지 내용으로 분기된 내용을 ssh2 콘솔창에 입력 후 실행

        - 리턴받아야 하는 결과값이 없으면 상황종료 
        - 리턴받아야 하는 결과값이 있으면 콘솔창에 찍혀있는 텍스트를 
          webssh2-main/app/client/src/js/index.ts 파일의 socket.on('data', (data: string | Uint8Array) => 부분에서 
          결과값으로 전달받아 분기시켜 해당 텍스트에 맞는 함수를 실행해 coding_view.ejs에 메세지 전송
        - coding_view.ejs 의 window.addEventListener('message', function(e) 부분에서 메세지를 전송받아 해당 메세지에 맞는 함수 실행

    
    */
    // ssh2 연결
    var connectToTerminal = function(index) {
        msgData.Cmd = 'clearConsole';
        var termFrm = document.getElementById('termFrm0').contentWindow;
         // webssh2 쪽 client/index.ts에 clearConsole 전송
        termFrm.postMessage('clearConsole', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
        //$('div.tempLayerPopWrap').show();
    }

    // flask web 실행
    var flaskrunToTerminal = function(index) {
        msgData.Cmd = 'flaskRunPy';
        var termFrm = document.getElementById('termFrmTemp').contentWindow;
        // webssh2 쪽 client/index.ts에 flaskRunPy 전송
        termFrm.postMessage('flaskRunPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
        
    }

    // flask web 종료
    var flaskstopToTerminal = function(index) {
        msgData.Cmd = 'stopPy';
        var termFrm = document.getElementById('termFrmTemp').contentWindow;
        // webssh2 쪽 client/index.ts에 stopPy 전송
        termFrm.postMessage('stopPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }

    var sendMainPyToTerminal = function(index, jsonStr) {
        msgData.Cmd = 'buildPy';
        var termFrm = document.getElementById('termFrm0').contentWindow;
        termFrm.postMessage('buildPy|'+index+'|'+jsonStr, '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }
    

    var runToTerminal = function(index) {
        msgData.Cmd = 'runPy';
        var termFrm = document.getElementById('termFrm0').contentWindow;
        // webssh2 쪽 client/index.ts에 runPy 전송
        termFrm.postMessage('runPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
        //$('div.tempLayerPopWrap').show();
    }

    /// ssh2 동작 중지
    var stopToTerminal = function(index) {
        msgData.Cmd = 'stopPy';
        var termFrm = document.getElementById('termFrm0').contentWindow;
        // webssh2 쪽 client/index.ts에 stopPy 전송
        termFrm.postMessage('stopPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }

    /// ssh2 동작 중지
    var initializeToTerminal = function(index) {
        msgData.Cmd = 'killPy';
        var termFrm = document.getElementById('termFrmTemp').contentWindow;
        // webssh2 쪽 client/index.ts에 killPy 전송
        termFrm.postMessage('killPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }

    var getProjectJsonList = function() {
        //var termFrm = document.getElementById('termFrmTemp').contentWindow;
        //termFrm.postMessage('getProjectJsonList', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }

    var buildPythonCode = function(index) {
        //console.log('buildPy Called..'+index);
        var code = $("#code"+index).val();
            code = code.replace("\n", "\r\n");

        //var keyboardYN = $("#keyboard_"+index).val();
        //var cameraYN = $("#camera_"+index).val();
        //var recordYN = $("#driving_"+index).val();
        //var pltImShowYN = $("#imshow_"+index).val();
        var cameraYN = $('#take_picture_yn').val();
        var recordYN = $('#driving_picture_yn').val();
        var saveNpzYN = $('#save_npz_yn').val();
        var saveModelYN = $('#save_model_yn').val();

        var param = {
            code: code,
            keyboard_yn: 'N',
            camera_yn: cameraYN,
            record_yn: recordYN,
            save_npz_yn: saveNpzYN,
            save_model_yn: saveModelYN,
            pltimshow_yn: 'N'
        }

        $.ajax({
            url: "/blocks/runcoding",
            type: "GET",
            dataType: 'json',
            data: param,
            success: function (data) {
                connectToTerminal(index);
                sendMainPyToTerminal(index, JSON.stringify(data));
                //runToTerminal(index);
            }
        })
    }

    

    var getPicturesOfCamera = function(index, pictureFolderName, jsonText) {

        var sendInfoObj = {};

        if(pictureFolderName == 'cam') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/cam/",
                relpath: "cam/",
                filename: ""
            };
            
        }
        if(pictureFolderName == 'training') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/data/training/",
                relpath: "data/training/",
                filename: ""
            };
            
        }

        var tabIdx = $('a.nav-link.active').attr('navindex');
        var curWorkspace = $('#editor'+tabIdx).find('article.explain-zone iframe').get(0).contentWindow;
        curWorkspace.viewDataAfterRunCoding(sendInfoObj);
        
    }

    var getSavedDataAfterRun = function(index, dataName) {

        var sendInfoObj = {};

        if(dataName == 'npz') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/",
                relpath: "project/"+$('#projectId').data('project_name')+"/",
                filename: $('#save_npz_yn').data('save_name')
            };
            
        }
        if(dataName == 'model') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/model/",
                relpath: "project/"+$('#projectId').data('project_name')+"/model/",
                filename: $('#save_model_yn').data('save_name')
            };
            
        }
        if(dataName == 'pltimg') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/train_history/",
                relpath: "project/"+$('#projectId').data('project_name')+"/train_history/",
                filename: $('#save_pltshow_yn').data('save_name')
            };

        }

        var tabIdx = $('a.nav-link.active').attr('navindex');
        var curWorkspace = $('#editor'+tabIdx).find('article.explain-zone iframe').get(0).contentWindow;
        curWorkspace.viewDataAfterRunCoding(sendInfoObj);
        
    }

    var getUploadPopupData = function(dataName, dataParam) {

        var sendInfoObj = {};

        if(dataName == 'names') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/",
                relpath: "project/"+$('#projectId').data('project_name')+"/",
                filename: "names.json"
            };
            
        }
        if(dataName == 'images') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/result/",
                relpath: "project/"+$('#projectId').data('project_name')+"/result/",
                filename: dataParam.img_name
            };

        }
        if(dataName == 'pictures') {
            sendInfoObj = {
                fullpath: "/home/pi/autonomousCar/block/project/"+$('#projectId').data('project_name')+"/data/"+dataParam.class_name+"/",
                relpath: "project/"+$('#projectId').data('project_name')+"/data/"+dataParam.class_name+"/",
                filename: dataParam.img_name
            };

        }

        var tabIdx = $('a.nav-link.active').attr('navindex');
        var curWorkspace = $('#editor'+tabIdx).find('article.explain-zone iframe').get(0).contentWindow;
        curWorkspace.viewDataAfterRunCoding(sendInfoObj);
        
    }
    

    // webssh2 서버에서 보내는 메시지 수신용
    // 해당 서버에서 넘어오는 메시지를 확인해 해당 함수 실행
    window.addEventListener('message', function(e) {
        //console.log(e.data);
        var splitDataArr = e.data.split('|');
        var termCmd = '', termIdx = '', imgRootFolderName = '', jsonText = '';
        if( splitDataArr && splitDataArr.length > 1 ) {
            termCmd = splitDataArr[0];
            termIdx = splitDataArr[1];
            imgRootFolderName = splitDataArr[2];
            jsonText = splitDataArr[3];
        }
        if( termCmd == 'takePictures' ) {
            getPicturesOfCamera(termIdx, 'cam');
        }
        if( termCmd == 'dataPictures' ) {
            getPicturesOfCamera(termIdx, 'training', jsonText);
        }
        if( termCmd == 'savedNpzData' ) {
            getSavedDataAfterRun(termIdx, 'npz');
        }
        if( termCmd == 'savedTensorFlowModel' ) {
            getSavedDataAfterRun(termIdx, 'model');
        }

    });

    var toggleRunButton = function() {
        $('#runBtn').removeClass('active');
        $('#stopBtn').removeClass('active');
        $('#runBtn').addClass('active');
    }

    var tabPaneResultTrigger = function() {
        $('#tab-mark').removeClass('active').removeClass('ms-1').addClass('me-1');
        $('#tab-list').removeClass('me-1').addClass('ms-1').addClass('active');
        $('#pane-mark').removeClass('active').removeClass('show');
        $('#pane-list').addClass('active');
    }

    var addTabContents = function(tabIndex) {
        // active
        $('a.nav-link').removeClass('active');
        $('div.tab-pane').removeClass('active').removeClass('show');
        // title tab append
        var titleTabText = `
        <a class="nav-link active" href="#tab${tabIndex}-panel" id="tab${tabIndex}" navindex="${tabIndex}" data-bs-toggle="tab" data-bs-target="#tab${tabIndex}-panel" role="tab" aria-controls="tab${tabIndex}-panel" title="제목없음 선택됨">
            <span class="changetitle">
                <input type="text" id="subtitle${tabIndex}" value="제목없음${tabIndex}" minlength="1" maxlength="20">
            </span>
            <button type="button" class="border-0 cls_rm_tab" tabindex="${tabIndex}" title="제목없음 탭 삭제 "><i class="bi bi-x"></i></button>
        </a>
        `
        $('#titleTabList').append(titleTabText);
        // content append
        var contentTabText = `
        <div class="tab-pane text-white fade show active" id="tab${tabIndex}-panel" aria-labelledby="tab${tabIndex}" role="tabpanel">
            <section class="codingview" id="editor${tabIndex}">
                <div class="editor_wrap">
                    <article class="explain-zone">
                        <iframe src="/mycoding/workspace?index=${tabIndex}" width="100%" height="100%" frameborder="0"></iframe>
                    </article>
                    <article class="run-zone" style="display:none;">
                        <textarea id="code${tabIndex}" name="code${tabIndex}"></textarea>
                    </article>
                </div>
            </section>
        </div>
        <input type="hidden" id="content_sub${tabIndex}" name="content_sub" contindex="${tabIndex}" 
                data-sub-seq="${tabIndex+1}" 
                data-sub-title="제목없음${tabIndex}" 
                value="" />
        `
        $('#contentTabList').append(contentTabText);
    }

    var removeTabContents = function(tabIndex) {
        // active
        $('#tab'+tabIndex).prev().addClass('active');
        $('#tab'+tabIndex+'-panel').prev().prev().addClass('active').addClass('show');
        // title tab remove
        $('#tab'+tabIndex).remove();
        // content remove
        $('#tab'+tabIndex+'-panel').remove();
        $('#content_sub'+tabIndex).remove();
    }

    var openConsole = function() {
        var contentHeight = $('#content-wrapper').height();
        var height2 = contentHeight / 2 - 10;
        $('#content-wrapper').css('height', height2);
