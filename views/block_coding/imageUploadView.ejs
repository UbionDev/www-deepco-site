<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>업로드│AI Kit</title>
    <link rel="stylesheet" href="/ai_site/static/css/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/ai_site/static/css/UploadView.min.css"><!-- customize -->

</head>

<body>

    <div class="container-fluid pb-3" role="main">
        <ul class="nav nav-pills my-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link px-sm-6 active" id="imgUpload1-tab" data-bs-toggle="pill"
                    data-bs-target="#imgUpload1" type="button" role="tab" aria-controls="imgUpload1"
                    aria-selected="true"><i class="bi bi-image me-2"></i>이미지업로드</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link px-sm-6" id="imgUpload2-tab" data-bs-toggle="pill" data-bs-target="#imgUpload2"
                    type="button" role="tab" aria-controls="imgUpload2" aria-selected="false"><i
                        class="bi bi-pencil-square me-2"></i>드로잉패드</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link px-sm-6" id="imgUpload3-tab" data-bs-toggle="pill" data-bs-target="#imgUpload3"
                    type="button" role="tab" aria-controls="imgUpload3" aria-selected="false"><i
                        class="bi bi-camera me-2"></i>사진촬영</button>
            </li>
        </ul>
        <div class="tab-content" id="pills-tabContent">
            <div class="tab-pane fade show active" id="imgUpload1" role="tabpanel" aria-labelledby="imgUpload1-tab">
                <div class="card card-body">
                    <form class="row g-3">
                        <div class="col-sm-10">
                            <input type="file" class="form-control file-upload-field" name="img" id="imageFileUpload"
                                aria-describedby="inputimageFileAdd" aria-label="Upload">
                        </div>
                        <div class="col-sm-2">
                            <button id="fileUploadBtn" class="btn btn-dark w-100">저장</button>
                        </div>
                        
                    </form>
                </div>
            </div>
            <div class=" tab-pane fade" id="imgUpload2" role="tabpanel" aria-labelledby="imgUpload2-tab">
                <div class="card card-body">
                    <form class="row g-3 mb-2 justify-content-center">
                        <div class="col-5 col-md-3">
                            <button type="button" id="canvas-clear" class="btn btn-outline-dark w-100">지우기</button>
                        </div>
                        <div class="col-5 col-md-3">
                            <button type="button" id="canvas-save" class="btn btn-dark w-100">저장</button>
                        </div>
                    </form>

                    <canvas id="sign-canvas" class="sign-canvas"></canvas>
                    <textarea id="image-data" cols="30" rows="6"></textarea>

                </div>
            </div>
            <div class="tab-pane fade" id="imgUpload3" role="tabpanel" aria-labelledby="imgUpload3-tab">
                <div class="card card-body">
                    <div class="col-12 col-lg-7 mx-auto p-4">
                        
                        <div class="text-center" id="cameraLoadingBar" style="display: none;">
                            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                        </div>
                        <div id="video" style="display: none;">
                            <img class="w-100" src="#" alt="Connecting to Live Video" >
                        </div>
                    </div>
                    <form class="row g-3 pb-2 justify-content-center">
                        <div class="col-3 col-md-3">
                            <button type="button" class="btn btn-outline-dark w-100" id="btnCamCheck">카메라 연결</button>
                        </div>
                        <div class="col-3 col-md-3">
                            <!--<button type="button" class="btn btn-outline-dark w-100" id="btn-stop">STOP</button>-->
                            <button type="button" class="btn btn-dark text-white w-100" id="btnCamClose">카메라 종료</button>
                        </div>
                        <div class="col-3 col-md-3">
                            <button type="button" class="btn btn-dark text-white w-100" id="btn-addclass">ADD
                                CLASS</button>
                        </div>
                        <div class="col-3 col-md-3">
                            <button type="button" class="btn btn-dark text-white w-100" id="btn-takeResultPic">
                                Result Picture</button>
                        </div>

                    </form>
                    <ul class="col-12 list-unstyled mt-2 border-top" id="addspace">
                        
                    </ul>
                </div>
            </div>
        </div>
    </div>

    

</body>

<script src="/vendor/jquery/jquery-2.1.1.min.js"></script>
<script src="/vendor/jquery-ui-1.12.1/jquery-ui.min.js"></script>
<script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
<script src="/ai_site/static/vendor/bootstrap/bootstrap.bundle.min.js"></script>

<script>
    // 이미지 업로드 controller 호출
    function callFileUpload(formData) {
        return $.ajax({
            url: "/common/file/upload",
            type: "POST",
            enctype: "multipart/form-data",
            headers: {},
            data: formData,
            contentType: false,
            processData: false,
            success: function (data) {
                console.log(data.originalname);
            },
            error: function (error) {
                console.log('Fail: ', error);
            }
        });
    }

    $(document).ready(function () {


        // 파일 업로드 
        $("#fileUploadBtn").click(function () {
            var target = $('input.file-upload-field');
            var formData = new FormData();
            formData.append('attahces', target.prop('files')[0]);
            callFileUpload(formData).done(function (res) {
                console.log(res);
            });
        });

        // 키트 카메라 연결 영상
        $(document).on("click", "#btnCamCheck", function() {
            $('#cameraLoadingBar').show();
            opener.parent.flaskstopToTerminal();
            opener.parent.flaskrunToTerminal();
            setTimeout(function(){
                $('#cameraLoadingBar').hide();
                $('#video > img').attr('src', '<%=_prop.Api.WebSSH2Domain.RootUrl %>:5000/video_feed.mjpg?precheck=camera_required')
                .attr('style', 'padding: 10px;');
                $('#video').show();
            }, 5000);
        });

        // 키트 카메라 종료
        $(document).on('click', '#btnCamClose', function(){
            opener.parent.flaskstopToTerminal();
            $('#video').hide();
            $('#video > img').attr('src', '#');
            
        });

        // 키트 카메라 사진 촬영 (데이터 수집용)
        $(document).on("click", ".btn-takepic", function () {

            if(opener.parent.$("#folderList").val() == null){
                alert("폴더를 선택하세요.")
                return;
            }

            var cnt = $(this).attr("cnt");
            var img_cnt = $(this).attr("imgcnt");
            img_cnt = parseInt(img_cnt);
            // coding_view.ejs 의 takePicToTerminal 호출
            //opener.parent.takePicToTerminal(cnt);
            var flask_img_src = 'http://192.168.50.1:5000/single_frame.jpg?precheck=';
            flask_img_src += '&project_folder='+opener.parent.$("#folderList").val();
            flask_img_src += '&class_idx='+cnt;
            flask_img_src += '&file_idx='+(img_cnt+1);  console.log(flask_img_src);
            $(this).attr("imgcnt", (img_cnt+1) );
            $(".imgbox" + cnt).append("<img src='"+flask_img_src+"' />");

            if ($(".btn-takepic").length == parseInt(cnt)) {
                // coding_view.ejs 의 updateToolboxCategory 호출
                opener.parent.updateToolboxCategory();
            }

        });

        // 키트 카메라 사진 촬영 (결과 비교용)
        $(document).on("click", "#btn-takeResultPic", function () {
            opener.parent.takeResultPicToTerminal();
        });

        // 촬영된 사진 보기
        $(document).on("click", ".btn-showpic", function () {
            var cnt = $(this).attr("cnt");
            $(".imgbox" + cnt).empty();
            $.ajax({
                url: "<%=_prop.Api.WebSSH2Domain.RootUrl%>/cam/pictures?folder_root="+opener.parent.$("#folderList").val()+"&folder_name=class" + cnt,
                type: "GET",
                dataType: 'json',
                success: function (data) {

                    for (var i = 0; i < data.length; i++) {
                        $(".imgbox" + cnt).append("<img src='" + data[i] + "' />");
                    }
                }
            });
        });

        // 사진 촬영 중단
        $("#btn-stop").click(function () {
            opener.parent.stopToTerminal();

        });

        var classCount = 0;

        // 키트 내부 하위 폴더 추가 (데이터 수집)
        $("#btn-addclass").click(function () {

            if(opener.parent.$("#folderList").val() == null){
                alert("폴더를 선택하세요.")
                return;
            }

            classCount = classCount + 1;
            var contents = `
            <li class="py-2 border-bottom add${classCount}">
                <button type="button" class="btn btn-outline-dark btn-sm btn-takepic" cnt="${classCount}" imgcnt="0" >TAKEPIC</button>
                <!--<button type="button" class="btn btn-outline-dark btn-sm btn-showpic" data-bs-toggle="collapse"
                    data-bs-target=".imgbox${classCount}" aria-expanded="false"
                    aria-controls="imgbox${classCount}" cnt="${classCount}" >SHOW</button>-->
                <div class="imgbox${classCount}" class="collapse py-2" style="margin: 5px 0;">
                </div>
            </li>
            `;
            $("#addspace").append(contents);
            
            opener.parent.addClassToTerminal(classCount);
        });

    });

    // 캔버스
    var canvas;

    // 관리용 Context
    var ctx;

    // 현재 좌표
    var sx, sy;

    // 현재 그리기 여부
    var drawing = false;

    window.onload = function () {
        canvas = document.getElementById("sign-canvas");

        if (canvas == null || canvas.getContext == null) return;

        ctx = canvas.getContext("2d");
        ctx.strokeStyle = "black"
        ctx.lineWidth = "3";
        ctx.lineCap = "round";

        // 현재 포지션 저장
        canvas.onmousedown = function (e) {
            e.preventDefault();
            sx = canvasX(e.clientX);
            sy = canvasY(e.clientY);
            drawing = true;
        }

        // 마우스 이동에 따른 그리기
        canvas.onmousemove = function (e) {
            if (drawing) {
                e.preventDefault();

                ctx.beginPath();
                ctx.moveTo(sx, sy);
                sx = canvasX(e.clientX);
                sy = canvasY(e.clientY);

                ctx.lineTo(sx, sy);
                ctx.stroke();
            }
        }


        function canvasX(clientX) {
            var bound = canvas.getBoundingClientRect();
            var bw = 5;
            return (clientX - bound.left - bw) * (canvas.width / (bound.width - bw * 2));
        }



        function canvasY(clientY) {
            var bound = canvas.getBoundingClientRect();
            var bw = 5;
            return (clientY - bound.top - bw) * (canvas.height / (bound.height - bw * 2));
        }

        // 그리기 종료
        canvas.onmouseup = function (e) {
            drawing = false;
        }


        var btnClear = document.getElementById("canvas-clear");
        btnClear.onclick = function (e) {

            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        var btnSave = document.getElementById("canvas-save");
        btnSave.onclick = function (e) {

            var param = {
                base64Data: canvas.toDataURL()
            }

            $.ajax({
                url: "/common/file/base64upload",
                type: "POST",
                dataType: 'json',
                data: param,
                success: function (data) {
                    console.log(data);
                    var imageData = document.getElementById("image-data");
                    imageData.innerText = data;
                }
            });

            // var imageData = document.getElementById("image-data");
            // imageData.innerText = canvas.toDataURL();


            // var imageSign = document.getElementById("image-sign");
            // imageSign.src=canvas.toDataURL();
        }
    }

</script>