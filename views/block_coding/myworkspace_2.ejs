    class ToolboxButton extends Blockly.ToolboxItem {
      constructor(toolboxItemDef, parentToolbox) {
        super(toolboxItemDef, parentToolbox);
      }

      init() {
        this.button = document.createElement('button');
        this.button.textContent = this.toolboxItemDef_['name'];
        if( this.toolboxItemDef_['name'] == 'Set Project' ) { this.button.setAttribute('id', 'btnSetProject'); }
        if( this.toolboxItemDef_['name'] == 'Get Project' ) { this.button.setAttribute('id', 'btnGetProject'); }
        if( this.toolboxItemDef_['name'] == 'Upload Image' ) { this.button.setAttribute('id', 'btnUploadImage'); }
        this.button.onclick = function() { 
          //console.log('Click.. ' + this.getAttribute('id'));
          if( this.getAttribute('id') == 'btnSetProject' ) {  // 프로젝트 생성 관리
            window.open("http://kit.ubion.co.kr/project/manageview", "imgUpload", "_blank");
          }
          if( this.getAttribute('id') == 'btnGetProject' ) {  // 프로젝트 가져오기
            //parent.getFolderListToTerminal();
            parent.getProjectJsonList();
          }
          if( this.getAttribute('id') == 'btnUploadImage' ) {  // 데이터 수집
            window.open("http://kit.ubion.co.kr/common/img/uploadview", "imgUpload", "_blank");
          }
        }
      }

      getDiv() {
        return this.button;
      }
    }

    Blockly.registry.register(
        Blockly.registry.Type.TOOLBOX_ITEM,
        'toolboxbutton',
        ToolboxButton
      );

