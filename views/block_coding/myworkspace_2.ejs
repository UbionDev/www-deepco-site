    <script type="text/javascript">
        $(function() {
            //* 블록코딩 코드보기
            var toggled = false;
            $(".output-panel").bind('click touch', function(){
                $(this).css('right', '-600px');
                $(this).toggleClass("show");
                toggled = !toggled;
                if(toggled) { $(this).css('right', '0px'); }
                if($(this).attr('id') == "codeDiv"){
                    $(this).children('.openclose').children('i').attr('class', toggled ? 'bi bi-x': 'bi bi-code-slash');

                }
                if($(this).attr('id') == "folderDiv"){
                    $(this).children('.openclose').children('i').attr('class', toggled ? 'bi bi-x': 'bi bi-folder');
                }
            });
            // 블록코딩 코드보기 */
            //* 블록코딩 코드복사
            $("#btnCopy").bind('click touch', function(){
                var editIndex = $("input[name=edit_index]").val();
                parent.copyCodeToClipBoard(editIndex);
            });
            // 블록코딩 코드복사 */
            //* Save Coding
            $("#savecoding").bind('click touch', function(){
                $('#savecoding').removeClass('active');
                $('#rmcoding').addClass('active');
                var editIndex = $("input[name=edit_index]").val();
                parent.saveProjectContents(editIndex);
            });
            // Save Coding */
            //* Remove Coding
            $("#rmcoding").bind('click touch', function(){
                var editIndex = $("input[name=edit_index]").val();
                parent.removeProjectContents(editIndex);
            });
            // Remove Coding */
            //* Run py
            $("#runBtn").bind('click touch', function(){
                var editIndex = $("input[name=edit_index]").val();
                parent.runCodingShell(editIndex);
                toggleRunButton();
            });
            // Run py */
            //* Stop py
            $("#stopBtn").bind('click touch', function(){
                var editIndex = $("input[name=edit_index]").val();
                parent.stopCodingShell(editIndex);
                toggleRunButton();
            });
            // Stop py */

            var toggleRunButton = function() {
                $('#runBtn').toggleClass('active');
                $('#stopBtn').toggleClass('active');
            }

            $("#projectname").val(parent.$("#folderList > option").eq(0).val());
            
        });

        //* Kit folder data view
        var viewDirFrameData =  function() {
            var childFrame = document.getElementById("kitFrmDir").contentWindow;//window.frames[0];
            var childKit = new ByPassCORS(childFrame);
            childKit = getEventListener(childKit);

            var data_fileter_list = [];
            data_fileter_list.push({'directory' : ['cam', 'data', 'project']});
            data_fileter_list.push({'picture' : ['jpg']});
            data_fileter_list.push({'form' : ['npz', 'json', 'csv']});
            data_fileter_list.push({'model' : ['h5']});

            var project_folder = parent.$('#projectId').data('project_name');
            data_fileter_list.push({'project_directory' : [ project_folder ]});

            childKit.sendMessage("setDataFilters", data_fileter_list);
        }
        //*/

        //* 폴더 보기 업데이트
        var viewDataAfterRunCoding = function(sendInfoObj) {

            var childFrame = document.getElementById("kitFrmDir").contentWindow;//window.frames[0];
                childKit = new ByPassCORS(childFrame);
                childKit = getEventListener(childKit);

                childKit.sendMessage("viewDataAfterRunCoding", sendInfoObj);
        }
        //*/// viewDataAfterRunCoding

    </script>
