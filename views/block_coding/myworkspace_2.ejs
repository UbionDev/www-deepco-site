            if(scope.block.type == 'block_group') { return 'enabled'; }
            else { return 'disabled'; }
          },
          callback: function(scope) {
            //console.log(scope);
            var copyGroupDom = Blockly.Xml.blockToDom(scope.block);
            parent.copyBlocksToStorage(copyGroupDom);
          },
          scopeType: Blockly.ContextMenuRegistry.ScopeType.BLOCK,
          id: 'custom_copy_menu',
        }
        Blockly.ContextMenuRegistry.registry.register(blockItem);
        const workspaceItem = {
          displayText: 'Paste',
          preconditionFn: function(scope) {
            return 'enabled';
          },
          callback: function(scope) {
            //console.log(localStorage.getItem('groupBlocks'));
            var pasteGroupDom = Blockly.Xml.textToDom(localStorage.getItem('groupBlocks'));
            var rtn = Blockly.Xml.appendDomToWorkspace(pasteGroupDom, workspace);
            localStorage.removeItem('groupBlocks');
          },
          scopeType: Blockly.ContextMenuRegistry.ScopeType.WORKSPACE,
          id: 'custom_paste_menu',
          weight: 100,
        };
        Blockly.ContextMenuRegistry.registry.register(workspaceItem);
    }
