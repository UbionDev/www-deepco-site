                    data.forEach(element => {
                        var Text = `<li class="${element.id} bookmarkbtn" seq="${element.bookmark_seq}"><a href="#">${element.bookmark_seq}. (${convertTime(element.bookmark_time)}) ${element.bookmark_title}</a></li>`
                        $("#tab-mark > ul").append(Text);

                        bookmark_time.push(element.bookmark_time);
                    });

                }

            }
        });
    }
    //*/

    var convertTime = function(seconds){
        var mmssTime = "00:00";
        var min = parseInt(seconds/60) < 10 ? '0' + parseInt(seconds/60) : parseInt(seconds/60);
        var sec = seconds%60 < 10 ? '0' + seconds%60 : seconds%60;
        mmssTime = min + ":" + sec;
        return mmssTime;
    }

  </script>
