<script src='https://www.youtube.com/iframe_api'></script>
<script>

    var player;
    var timer;
    var bookmark_time;
    var offset = 0;

    function onYouTubeIframeAPIReady() {
        
        player = new YT.Player('inputarea', {
            videoId: 's2_xaEvcVI0',
            playerVars: {'autoplay': 1, 'showinfo': 0, 'rel':0, 'modestbranding':1,
                'wmode':'transparent', 'autohide':1
            },
            events: {
                'onReady': onPlayerReady,
                'onStateChange': onPlayerStateChange
            }

        });

    }

    function onPlayerReady(event) {

        event.target.setPlaybackQuality("hd720");

        // 추가한 소스..
        // console.log(player.getCurrentTime());
        // console.log(player.getDuration());
    }

    function onPlayerStateChange(event) {

        if (event.data == YT.PlayerState.PLAYING) {
            event.target.setPlaybackQuality('hd720');
            timer = setInterval(function(){
                
                for (var i = 0; i < bookmark_time.length; i++)
                {
                    if(bookmark_time[i] == Math.round(player.getCurrentTime()))
                    {
                        $('.bookmark').find('li').removeClass('active');
                        $('.bookmark').find('li.'+(i+1)).addClass('active');

                        offset = offset + $(".scroll"+i).offset().top;
                        
                        $('.move').animate({scrollTop : offset -80}, 400);
                        
                    }
                }
            },1000)
        }
        else if(event.data == YT.PlayerState.ENDED || event.data == YT.PlayerState.PAUSED){
            clearInterval(timer)
        }
    }

    var blocksToCode = function(editIndex, wrCode, xmlDom, keyboardYN) {
        $("#code" + editIndex).val(wrCode);
        var xmlDomElem = $(xmlDom);
        var xmlText = '<xml xmlns="https://developers.google.com/blockly/xml" id="coding_block_'+editIndex+'" style="display: none">';
            xmlText += xmlDomElem.html() + '</xml>';
            //console.log( xmlText );
        //$("#xml_block_" + editIndex).remove();
        $("#coding_block_" + editIndex).remove();
        $("#tabs" + editIndex).append( xmlText );

        var keyboardTagText = '<input type="hidden" id="keyboard_'+editIndex+'" value="'+keyboardYN+'" />';
        $("#keyboard_"+editIndex).remove();
        $("#tabs" + editIndex).append( keyboardTagText );
    }

    var setCameraPictures = function(editIndex, cameraYN) {
        var cameraTagText = '<input type="hidden" id="camera_'+editIndex+'" value="'+cameraYN+'" />';
        $("#camera_"+editIndex).remove();
        $("#tabs" + editIndex).append( cameraTagText );
    }

    var setDrivingPictures = function(editIndex, recordYN) {
        var drivingTagText = '<input type="hidden" id="driving_'+editIndex+'" value="'+recordYN+'" />';
        $("#driving_"+editIndex).remove();
        $("#tabs" + editIndex).append( drivingTagText );
    }

    var setPltImShow = function(editIndex, pltImShowYN) {
        var imShowTagText = '<input type="hidden" id="imshow_'+editIndex+'" value="'+pltImShowYN+'" />';
        $("#imshow_"+editIndex).remove();
        $("#tabs" + editIndex).append( imShowTagText );
    }

    var copyCodeToClipBoard = function(editIndex) {
        var copyElem = document.getElementById('code' + editIndex);
        var tempTextArea = document.createElement("textarea");
        document.body.appendChild(tempTextArea);
        tempTextArea.value = copyElem.value;
        tempTextArea.select();
        document.execCommand('copy');
        document.body.removeChild(tempTextArea);
        alert('Code Copied.');
    }

    var msgData = {};

    var connectToTerminal = function(index) {
        msgData.Cmd = 'clearConsole';
        var termFrm = document.getElementById('termFrm'+index).contentWindow;
        termFrm.postMessage('clearConsole', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
        //$('div.tempLayerPopWrap').show();
    }

    var runToTerminal = function(index) {
        msgData.Cmd = 'runPy';
        var termFrm = document.getElementById('termFrm'+index).contentWindow;
        termFrm.postMessage('runPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
        //$('div.tempLayerPopWrap').show();
    }

    var initializeToTerminal = function(index) {
        msgData.Cmd = 'killPy';
        var termFrm = document.getElementById('termFrmTemp').contentWindow;
        termFrm.postMessage('killPy', '<%=_prop.Api.WebSSH2Domain.RootUrl%>:<%=_prop.Api.WebSSH2Domain.Port%>');
    }

    var buildPythonCode = function(index) {
        //console.log('buildPy Called..'+index);
        var code = $("#code"+index).val();
            code = code.replace("\n", "\r\n");

        var keyboardYN = $("#keyboard_"+index).val();
        var cameraYN = $("#camera_"+index).val();
        var recordYN = $("#driving_"+index).val();
        var pltImShowYN = $("#imshow_"+index).val();

        var param = {
            code: code,
            keyboard_yn: keyboardYN,
            camera_yn: cameraYN,
            record_yn: recordYN,
            pltimshow_yn: pltImShowYN
        }

        $.ajax({
            url: "/blocks/runcoding",
            type: "GET",
            dataType: 'json',
            data: param,
            success: function (data) {
                connectToTerminal(index);
                runToTerminal(index);
            }
        })
    }

    var imgshowToTerminal = function(index, imgRootFolderName) {

        var termFrm = $('#termFrm'+index);

        //* runimg 폴더에 이미지 목록 가져오기 기능 구현
        var param = {
            fileroot : imgRootFolderName
        }

        $.ajax({
            url: "/common/img/show",
            type: "POST",
            dataType: 'json',
            data: param,
            success: function (data) {
                $('#pictures_zone_'+index).remove();
                var pic_div = $('<div>').attr('id', 'pictures_zone_'+index);
                termFrm.parents('article').after(pic_div);
        
                data.forEach(function(element){
                    var Text = `<img src="http://192.168.50.1:3000/img/runimg/${element}" />`
                    pic_div.append(Text);
                });
            }
        });
        //*/

    }

    var getPicturesOfCamera = function(index, pictureFolderName) {

        var termFrm = $('#termFrm'+index);

        var param = {
            pictures_folder : pictureFolderName
        }

        
        $.ajax({
            url: "/common/camera/pictures",
            type: "GET",
            dataType: 'json',
            data: param,
            success: function (data) {
                //console.log(data);
                $('#pictures_zone_'+index).remove();
                drawPicturesOfCamera(index, pictureFolderName, data);
            }
        });

    }

    var drawPicturesOfCamera = function(index, pictureFolderName, data) {
        var termFrm = $('#termFrm'+index);
        var pic_div = $('<div>').attr('id', 'pictures_zone_'+index);
        termFrm.parents('article').after(pic_div);
        data.forEach(function(element){
            var img_url = 'http://192.168.50.1:3000';
            if(pictureFolderName == 'cam') { img_url += '/cam'; }
            else { img_url += '/data/training'; }
            img_url += '/' + element;
            pic_div.append(`<img src="${img_url}" />`);
        });
    }

    window.addEventListener('message', function(e) {
        //console.log(e.data);
        var splitDataArr = e.data.split('|');
        var termCmd = '', termIdx = '', imgRootFolderName = '';
        if( splitDataArr && splitDataArr.length > 1 ) {
            termCmd = splitDataArr[0];
            termIdx = splitDataArr[1];
            imgRootFolderName = splitDataArr[2];
        }
        if( termCmd == 'buildPy' ) {
            buildPythonCode(termIdx);
        }
        if( termCmd == 'killPy' ) {
            initializeToTerminal(termIdx);
            connectToTerminal(termIdx);
        }
        if( termCmd == 'takePictures' ) {
            getPicturesOfCamera(termIdx, 'cam');
        }
        if( termCmd == 'dataPictures' ) {
            getPicturesOfCamera(termIdx, 'training');
        }
        if( termCmd == 'imShow' ) {
            imgshowToTerminal(termIdx, 'runimg');
        }

        /*
