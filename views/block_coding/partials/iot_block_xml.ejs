<category name="Camera" css-icon="customIcon bi bi-camera" colour="%{BKY_LOOPS_HUE}" css-container="blocklyToolboxCategory depth2">
    <variables>
        <variable>image</variable>
    </variables>
    <!--<block type="camera_ready"></block>-->
    <!--<block type="camera_picture"></block>-->
    <block type="set_image_take_picture"><value name="obj_image"><block type="variables_get"><field name="VAR">image</field></block></value></block>
    <block type="set_image_to_global_frame">
        <value name="obj_image"><block type="variables_get"><field name="VAR">image</field></block></value>
    </block>
    <block type="save_image_to_file">
        <value name="obj_image"><block type="variables_get"><field name="VAR">image</field></block></value>
        <value name="obj_text"><block type="text"><field name="TEXT">picture1.jpg</field></block></value>
    </block>
    <block type="save_image_to_project_file">
        <value name="obj_image"><block type="variables_get"><field name="VAR">image</field></block></value>
        <value name="obj_text"><block type="text"><field name="TEXT">picture1.jpg</field></block></value>
    </block>
    <block type="camera_end"></block>
</category>
