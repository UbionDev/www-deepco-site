<% layout('../../common/student/layout') -%>
<% stylesheet(Resources_Root_Domain +'/_inc/css/pages/mypage.css') -%>
<% script(Resources_Root_Domain +'/_inc/js/vendor/jquery-ui/jquery-ui.min.js') -%>
<% script(' /js/jquery.fileupload.js') -%>

 <!--snb-->
 <div class="snb_wrap">
    <ul class="snb_list student">
        <li><a class="btn current" href="#none" title="마이페이지 바로가기">마이페이지</a></li><!--현재 위치 .current -->
    </ul>
</div>
<!--//snb-->

<!--본문-->
<section class="cont_wrap" id="go_cont">
    <h3 class="ir_pm">본문</h3>
    <article class="cont_sc mypage">
        <h4 class="tit">개인정보 수정</h4>
        <div class="info_edit">
            <div class="profile">
                <button type="button" class="btn_edit" title="프로필 사진 수정하기"><span class="ir_pm">프로필 사진 수정하기</span><i class="material-icons">photo_camera</i></button>
                <input type="file" name="attach" style="display: none;" />
                <div id="profile">
                    <%if( loginInfo.profile_image_url ){%>
                        <img src="<%=loginInfo.profile_image_url%>" class="img" alt="내 프로필 사진" onerror="$(this).parent().html('<span><%=loginInfo.name.substring( loginInfo.name.length-2, loginInfo.name.length )%><span>');">
                    <%} else {%>
                        <!--프로필 사진이 없으면 이름 출력 (최대 2자까지)-->
                        <span><%=loginInfo.name.substring( loginInfo.name.length-2, loginInfo.name.length )%></span>
                    <%}%>
                </div>
            </div>
            <div class="info">
                <dl>
                    <dt>이름</dt>
                    <dd>
                        <label>
                            <span class="ir_pm">이름</span>
                            <input type="text" placeholder="<%= loginInfo.name %>" readonly>
                        </label>
                    </dd>
                    <dt>학교</dt>
                    <dd>
                        <label>
                            <span class="ir_pm">학교명</span>
                            <input type="text" placeholder="<%= loginInfo.sch_name %>" readonly>
                        </label>
                    </dd>
                    <dt>학년,반,번호</dt>
                    <dd>
                        <label>
                            <span class="ir_pm">학년,반,번호</span>
                            <input type="text" placeholder="<%= loginInfo.classes[0].grade %>학년 <%= loginInfo.classes[0].class_name %>반 <%= loginInfo.classes[0].stu_num %>번" readonly>
                        </label>
                    </dd>                           
                    <dt>비밀번호 변경</dt>
                    <dd>
                        <div>
                            <label>
                                <span class="ir_pm">현재 비밀번호 입력</span>
                                <input id="password" type="password" placeholder="현재 비밀번호를 입력하세요.">
                            </label>
                            <p id="password_info" class="warning" style="display: none;"><i class="material-icons">error_outline</i>비밀번호가 일치하지 않습니다!</p><!--잘못 입력했을 때 .warning-->
                        </div>
                        <div>
                            <label>
                                <span class="ir_pm">새 비밀번호 입력</span>
                                <input id="new_password" type="password" placeholder="새 비밀번호를 입력하세요.">
                            </label>
                        </div>
                        <div>
                            <label>
                                <span class="ir_pm">새 비밀번호 확인</span>
                                <input id="new_password_confirm" type="password" placeholder="새 비밀번호를 확인하세요.">
                            </label>
                            <p id="new_password_confirm_info" style="display: none;"><i class="material-icons">error_outline</i></p><!--잘못 입력했을 때 .warning / 제대로 입력했을 때 .info -->
                        </div>
                    </dd>
                </dl>
            </div>
            <div class="btn_sc">
                <button type="button" class="btn md gray">취소</button>
                <button id="saveBtn" type="button" class="btn md primary">저장</button>
            </div>
        </div>                
    </article>       
</section>
<!--//본문-->
<script>
    var isPasswordConfirm = true;
    $(document).ready(function(){

        $("#new_password, #new_password_confirm").on("keyup", function(){
            fn_passwordConfirm();
        });

        $("#saveBtn").on("click", function(){

            let password = $("#password").val();
            let new_password = $("#new_password").val();
            let new_password_confirm = $("#new_password_confirm").val();

            if( !password || !new_password || !new_password_confirm ){
                Message.Alert('', '입력하지 않은 항목이 있습니다.');
                return;
            }


            if( isPasswordConfirm ){

                $("#password_info").hide();
        
                var paramObj = {};
                paramObj.usr_id = '<%=loginInfo.usr_id %>';
                paramObj.type = '<%=loginInfo.type %>';
                paramObj.pwd = $("#password").val();
                paramObj.new_pwd = $("#new_password").val();
                Common.callHydeeAjax('/user/userInfo', paramObj, 'PUT').done(function (res) {
                    if( res.result_code === "00" ) {
                        if( res.data.result_detail === "pwd update fail" ){
                            $("#password_info").show();
                            $("#password").focus();
                        } else {
                            Message.Success('', '개인정보가 수정 되었습니다.');
                        }
                    } else {
                        Message.Disappoint('', '개인정보 수정에 실패했습니다.');
                    }
                });

            } else {
                Message.Disappoint('', '새 비밀번호가 일치하지 않습니다.');
            }

        });

    });

    function fn_passwordConfirm(){

        let new_password = $("#new_password").val();
        let new_password_confirm = $("#new_password_confirm").val();

        if( new_password || new_password_confirm ){

            let addClass = '';
            let infoHtml = '';

            if( new_password === new_password_confirm ){
                addClass = 'info';
                infoHtml = '<i class="material-icons">error_outline</i>비밀번호가 일치합니다.';
                isPasswordConfirm = true;
            } else {
                addClass = 'warning';
                infoHtml = '<i class="material-icons">error_outline</i>비밀번호가 일치하지 않습니다.';
                isPasswordConfirm = false;
            }

            $("#new_password_confirm_info").removeClass();
            $("#new_password_confirm_info").addClass( addClass );
            $("#new_password_confirm_info").html( infoHtml );
            $("#new_password_confirm_info").show();

        } else {

            isPasswordConfirm = true;

            $("#new_password_confirm_info").hide();
            $("#new_password_confirm_info").empty();

        }

    }



//프로필 이미지 업로드 버튼 클릭
$('.btn_edit').on('click', function(){

    Message.ThreeButton('', '프로필 사진을 변경하시겠습니까?', function(){
        $('input:file[name=attach]').click();
    }, function(){
        
        var formData = new FormData();

        var csrf_token = document.querySelector('meta[name="csrf-token"').getAttribute('content');

        $.ajax({
            url : '/student/mypage/saveProfileImage',
            type: "POST",
            enctype: "multipart/form-data",
            data: formData,
            headers: {
                'CSRF-Token': csrf_token
            },
            contentType: false,
            processData: false,
            success: function (res) {
                if( res.apiResponse.result_code === '00' ){
                    var profileImageHtml = '<span><%=loginInfo.name.substring( loginInfo.name.length - 2, loginInfo.name.length )%></span>';
                    $('#profile').html( profileImageHtml );
                    $('.personal_sc .mypage_sc .profile_img').html( profileImageHtml );
                }
            },
            error: function (error) {
                console.log('Fail: ', error);
            }
        });

    }, function(){
        
    }, {ok : '변경하기', cancel : '삭제하기', cls : '취소'});

});
//파일업로드 데이터 셋팅
// $('div#profile_upload_info_div > input:file[name=attach]').bind('fileuploadsubmit', function (e, data) {
//     data.formData = {
//     }
// });
//파일업로드
$('input:file[name=attach]').fileupload({
    beforeSend : function(xhr, data) {
        var csrf_token = document.querySelector('meta[name="csrf-token"').getAttribute('content');
        xhr.setRequestHeader('CSRF-Token', csrf_token);
    },
    url : '/student/mypage/saveProfileImage',
    dataType: 'json',
    done: function (e, data) {
        var result_code = data.result.result_code;
        if( result_code === '00' ){
            var profileImageHtml = '<img src="' + data.result.filepath + '" alt="내 프로필 사진" class="img">';
            $('#profile').html( profileImageHtml );
            $('.personal_sc .mypage_sc .profile_img').html( profileImageHtml );
        } else if( result_code === '04' ){
            // 지원하지 않는 확장자 파일
            Message.Alert( '', '지원하지 않는 확장자 파일이 포함되어 있습니다.<br/>업로드 가능 확장자 : ' + data.result.fileExtWhiteList );
        }
    }
});

</script>