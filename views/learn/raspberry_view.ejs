<script src='https://www.youtube.com/iframe_api'></script>
<script>

    var player;
    var timer;
    var bookmark_time;
    var offset = 0;

    function onYouTubeIframeAPIReady() {
        
        player = new YT.Player('inputarea', {
            videoId: 'fL3m0BUmYIs',
            playerVars: {'autoplay': 1, 'showinfo': 0, 'rel':0, 'modestbranding':1,
                'wmode':'transparent', 'autohide':1
            },
            events: {
                'onReady': onPlayerReady,
                'onStateChange': onPlayerStateChange
            }

        });

    }

    function onPlayerReady(event) {

        event.target.setPlaybackQuality("hd720");

        // 추가한 소스..
        // console.log(player.getCurrentTime());
        // console.log(player.getDuration());
    }

    function onPlayerStateChange(event) {

        if (event.data == YT.PlayerState.PLAYING) {
            event.target.setPlaybackQuality('hd720');
            timer = setInterval(function(){
                
                for (var i = 0; i < bookmark_time.length; i++)
                {
                    if(bookmark_time[i] == Math.round(player.getCurrentTime()))
                    {
                        $('.bookmark').find('li').removeClass('active');
                        $('.bookmark').find('li.'+(i+1)).addClass('active');

                        offset = offset + $(".scroll"+i).offset().top;
                        
                        $('.move').animate({scrollTop : offset -80}, 400);
                        
                    }
                }
            },1000)
        }
        else if(event.data == YT.PlayerState.ENDED || event.data == YT.PlayerState.PAUSED){
            clearInterval(timer)
        }
    }

    var blocksToCode = function(editIndex, wrCode, xmlDom) {
        $("#code" + editIndex).val(wrCode);
        var xmlDomElem = $(xmlDom);
        var xmlText = '<xml xmlns="https://developers.google.com/blockly/xml" id="xml_block_'+editIndex+'" style="display: none">';
            xmlText += xmlDomElem.html() + '</xml>';
            //console.log( xmlText );
        $("#xml_block_" + editIndex).remove();
        $("#tabs" + editIndex).append( xmlText );
    }

    var terminateProcess = function() {
        $.ajax({
            url: '/common/blocks/terminateProc',
            type: "POST",
            dataType: 'json',
            data: {},
            success: function (res) {  }
        })
    }

    $(document).ready(function () {
       
        var arr = [];
        bookmark_time = [];
        var i = 0;

        var content_len = 15;


        $(document).on("click", ".submit", function () {
            var index = $(this).attr("index");

            var code = $("#code"+index).val();


            code = code.replace("\n", "\r\n");

            param = {
                code: code
            }

            $.ajax({
              url: "/blocks/runcoding",
              type: "GET",
              dataType: 'json',
              data: param,
              success: function (data) {
                  $("#result" + index).html(data.text.replace(/\n/gi, "<br/>"));
              }

          });
        });

        $(document).on("click", ".bookmarkbtn", function () {
            
            $('.bookmark').find('li').removeClass('active');
            $(this).addClass('active');

            var seq = $(this).attr("seq");
            var index = parseInt(seq) - 1;

            offset = offset + $(".scroll"+index).offset().top;

            $('.move').animate({scrollTop : offset -80}, 400);

        });

        $(".move").scroll(function () {
            offset = $(".move").scrollTop();
        });

        // 강좌 선택했을때 회차 목록 조회
        $(document).on("click", ".lecturebtn", function () {

            $(this).parent().siblings("#dropdownMenuLecture").text($(this).text());

            $("#lectureid").val($(this).attr("lec_id"));

            getCourseList();

        });

        // 회차 선택했을때 회차에 따른 강의 내용 및 북마크 조회
        $(document).on('click', '.coursebtn', function () {

            $(this).parent().siblings("#dropdownMenuRound").text($(this).text());

            $("#lectureid").val($(this).attr("lecture_id"));
            $("#courseid").val($(this).attr("course_id"));

            getContents();

        });

        $(document).on('click', '.btnClose', function() {
            $('div.tempLayerPopWrap').hide();
        });

        getLectureList(0);

    });

    var initLectureInfo = function(){
        if( $(".lecturebtn") && $(".lecturebtn").length > 0 ) {
            var firstLectureInfo = $(".lecturebtn").eq(0);
            firstLectureInfo.parent().siblings("#dropdownMenuLecture").text(firstLectureInfo.text());
            $("#lectureid").val(firstLectureInfo.attr("lec_id"));
            getCourseList(0);
        }
    }

    var initCourseInfo = function(){
        if( $(".coursebtn") && $(".coursebtn").length > 0 ) {
            var firstCourseInfo = $(".coursebtn").eq(0);
            firstCourseInfo.parent().siblings("#dropdownMenuRound").text(firstCourseInfo.text());
            $("#courseid").val(firstCourseInfo.attr("course_id"));
            getContents(0);
        }
    }

    //* 강좌 목록 조회
    var getLectureList = function(status){

        $.ajax({
            url: '<%=_prop.Api.CodingContentUrl%>/gcodinglecturelist',
            type: "POST",
            dataType: 'json',
            data: {},
            success: function (res) {
                
                if(res.result_code == '00' && res.data != null) {
                    var lectureList = res.data.lecturelist;
                    if(lectureList && lectureList.length > 0) {
                        $(".lecturelist").empty();
                        lectureList.forEach(function(lecture){
                            var Text = `<button type="menuitem" class="dropdown-item lecturebtn" lec_id="${lecture.lecture_id}">${lecture.lecture_name}</button>`
                            $(".lecturelist").append(Text);
                        });
                    }
                    if(status == 0) {
                        initLectureInfo();
                    }
                }
            }
        });

    };
    //*/

    //* 회차 목록 조회
    var getCourseList = function(status){
        
        $.ajax({
            url: '<%=_prop.Api.CodingContentUrl%>/gcodingcourselist',
            type: "POST",
            dataType: 'json',
            data: {
                lecture_id: $("#lectureid").val()
            },
            success: function (res) {
                                
                if(res.result_code == '00' && res.data != null) {
                    var listarray = res.data.courselist;

                    if(listarray && listarray.length > 0) {
                        $(".courselist").empty();
                        
                        listarray.forEach(course => {
                            var Text = `<button type="menuitem" class="dropdown-item coursebtn" lecture_id="${course.lecture_id}" course_id="${course.course_id}">${course.course_id}. ${course.course_name}</button>`
                            $(".courselist").append(Text);
                        });
                    }
                    if(status == 0) {
                        initCourseInfo();
                    }
                }
            }
        });

    };
    //*/

    //* 강의 내용 조회
    var getContents = function(status){

        var arr = [];
        var i = 0;

        $.ajax({
            url: '<%=_prop.Api.CodingContentUrl%>/gcodingcontent',
            type: "POST",
            dataType: 'json',
            data: {
                lecture_id: $("#lectureid").val(),
                course_id: $("#courseid").val()
            },
            success: function (res) {

                if(res.result_code == '00' && res.data != null) {

                    var contents = res.data.contents[0];

                    if(contents) {

                        $("#editor").empty();
                        $("#editor").append(contents.content_desc);
                        arr = [];
                        i = 0;

                        for (var j = 0; j < Number(contents.content_len); j++) {

                            var defaultXmlText = '<xml xmlns="https://developers.google.com/blockly/xml" id="default_xml_block_'+j+'" style="display: none">';
                                defaultXmlText += '<category name="Blocks" colour="160">';
                                defaultXmlText += $("#tabs" + j).find("#xml_block_" + j).html();
                                defaultXmlText += '</category>';
                                defaultXmlText += '</xml>';
                            $("#tabs" + j).append(defaultXmlText);
                            
                            i += 1;

                        }

                        //*
                        $(".group-btn").each(function(){
                            //console.log($(this).html());
                            var btnTerminate = $('<button>').addClass('btn btn-danger').attr('style', 'margin-left: 3px;').text('종료');
                                btnTerminate.click(function(){
                                    terminateProcess();
                                });
                                $(this).append(btnTerminate);
                            var btnKeyBoard = $('<button>').addClass('btn btn-warning').attr('style', 'margin-left: 3px;').text('터미널 실행');
                                btnKeyBoard.click(function(){
                                    $('div.tempLayerPopWrap').show();
                                });
                                $(this).append(btnKeyBoard);
                            var btnData = $('<button>').addClass('btn btn-warning').attr('style', 'margin-left: 3px;').text('주행 데이터');
                            btnData.click(function(){
                                window.open("/common/training/img/view", "_blank");
                            });
                                //$(this).append(btnData);
                            
                        });
                        //*/

                    }

                    var bookmarkarray = res.data.bookmark;
                    if (bookmarkarray) {
                        $("#tab-mark > ul").empty();
                        bookmark_time = [];
                        bookmarkarray.forEach(element => {
                            var Text = `<li class="${element.bookmark_seq} bookmarkbtn" seq="${element.bookmark_seq}"><a href="#">${element.bookmark_seq}. (${convertTime(element.bookmark_time)}) ${element.bookmark_title}</a></li>`
                            $("#tab-mark > ul").append(Text);

                            bookmark_time.push(element.bookmark_time);
                        });
                    }

                    var coursearray = res.data.course;
                    if (coursearray) {
                        $("#tab-list > ul").empty();
                        coursearray.forEach(course => {
                            var actCls = '';
                            if( $("#courseid").val() == course.course_id ) {
                                actCls = 'active';
                                if(status != 0) { player.cueVideoById(course.course_link); }
                            }
                            var liText = `<li class="${actCls}"><a href="#">${course.course_id}. ${course.course_name}</a></li>`
                            $("#tab-list > ul").append(liText);
                        });
                    }

                }
                
            }
        });

    };
    //*/

    var convertTime = function(seconds){
        var mmssTime = "00:00";
        var min = parseInt(seconds/60) < 10 ? '0' + parseInt(seconds/60) : parseInt(seconds/60);
        var sec = seconds%60 < 10 ? '0' + seconds%60 : seconds%60;
        mmssTime = min + ":" + sec;
        return mmssTime;
    }

  </script>
