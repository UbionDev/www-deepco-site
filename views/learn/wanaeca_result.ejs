
<!DOCTYPE html>
<html lang="ko">

<head>

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>유비온 WOW Ai Lab 실습</title>
  <meta name="description" content="UBION AI LAB 실습사이트 입니다.">
  <meta content="AI LAB, AI연구소,실습,유비온" name="keywords">

  <!-- Favicons -->
  <link rel="icon" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/favicon.ico" >
  <link rel="apple-touch-icon" sizes="180x180" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/favicon-16x16.png">
  <link rel="manifest" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/site.webmanifest">
  <link rel="mask-icon" href="http://wdr.ubion.co.kr/CodingExercise/img/favicons/safari-pinned-tab.svg" color="#5bbad5">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="theme-color" content="#ffffff">


    <link rel="stylesheet" href="https://codemirror.net/lib/codemirror.css">
    <link rel="stylesheet" href="https://codemirror.net/theme/material-palenight.css">

    <script src="https://codemirror.net/lib/codemirror.js"></script>
    <script src="https://codemirror.net/mode/javascript/javascript.js"></script>
    <script src="https://codemirror.net/addon/selection/active-line.js"></script>
    <script src="https://codemirror.net/addon/edit/matchbrackets.js"></script>

  <!-- fonts -->
  <link href="http://wdr.ubion.co.kr/CodingExercise/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">

  <script src="http://code.jquery.com/jquery-2.1.1.min.js"></script>

  <!-- styles -->
  <link href="http://wdr.ubion.co.kr/CodingExercise/vendor/jquery.splitter/jquery.splitter.css" rel="stylesheet" type="text/css">
  <link href="http://wdr.ubion.co.kr/CodingExercise/css/main.min.css" rel="stylesheet">

  <script>
    $(document).ready(function(){

      var editor = CodeMirror.fromTextArea(document.getElementById("code"), {
          lineNumbers: true,
          matchBrackets: true,
          theme: 'material-palenight'
      });

      $("#codesubmit").click(function () {
        var code = editor.getValue();

        var usr_id = $("#usr_id").val();

        code = code.replace("\n", "\r\n");

        param = {
          code: code,
          usr_id : usr_id
        }

        $.ajax({
          url: "<%=_prop.Api.CodeExecuteUrl%>/test",
          type: "GET",
          dataType: 'json',
          data: param,
          success: function (data) {
            var type = data.type;
            var text = data.text;
            text = text.replace(/\>/gi, "&gt;")
            text = text.replace(/\</gi, "&lt;")

            if(type == "text"){
              $("#result").html(text.replace(/\n/gi, "<br/>"));
            }
            else{
              $("#result").html("<img src='"+text+"' />");
            }

            
          }

        });
      });

    });
    
  </script>
</head>

<body id="page-top">

  <!-- Page Wrapper -->
  <div id="wrapper">

    <!-- Topbar -->
    <nav class="navbar navbar-dark topbar static-top">
      <h1 class="navbar-brand">
        <i class="logo"></i><span class="ml-3"><%=p_title%></span>
        <!-- <span class="navbar-brand-text pl-1">01.실습 강의회차 제목</span> -->
      </h1>
    </nav>
    <!-- //Topbar -->

    <!-- Content Wrapper -->
    <!--실습영역id="content-wrapper"가 우측일 경우 class="way_right"/좌측일 경우 class="way_left" -->
    <div id="content-wrapper" class="way_right">
      <!-- 강의 영역 -->
      <div class="wrap d-flex flex-column">
        <div class="lecview">
            <div class="wrap">
              <article class="container-fluid">
                <div class="wrap">
                  <input type="hidden" id="usr_id" value="test" />
                  <div class="explain item  p-4">
                    <%-p_contents%>
                  </div>
                  <div class="hint item  p-4">
                    <h3 class="text-gray-800">유의사항</h3>
                    <ul class="mt-3">
                      <li><i class="fas fa-check"></i>실습평가는 필수활동이 아닙니다. 참여·제출 여부 및 점수와 상관없이 진도 80% 이상 시 수료할 수 있습니다.</li>
                      <li><i class="fas fa-check"></i>실습평가는 학습기간 내에 제출이 가능하며, 제출 시 모든 학습이 끝난 후에 개별피드백을 확인할 수 있습니다.</li>
                    </ul>
                  </div>
                </div>
              </article>
            </div>
        </div>
      </div>

      <!-- Main Content -->
      <div id="content">

        <!-- 코딩 입력 영역  -->
        <section class="container-fluid run-zone" >
          <h3 class="text-hide">실습내용입력</h3>
          <!-- Page Heading -->
          <div class="wrap-tab">
            <ul class="flex-column" id="run-tab">
              <li class="dir"><button class="d-inline-block" type="button" onclick="javascript:;alert('준비중');"><i class="far fa-folder"></i></li>
              <li class="active">
                <a href="#run-01" class="d-inline-block nav-link active" data-toggle="tab">ubion_exercise.py</a>
                <button class="d-inline-block" type="button"><i class="fas fa-times"></i></button>
              </li>
            </ul>
          </div>
          <div class="wrap-tabpanel">
            <article class="tab-pane fade show active" id="run-01" >
              <h4 class="text-hide">실습내용01</h4>
              <textarea id="code" name="code"><%=answer%></textarea>
            </article>
          </div>
        </section>
        <!-- //코딩 입력 영역 -->

        <!-- 실행 영역  -->
        <section class="container-fluid result-zone">
          <h3 class="text-hide">실행결과</h3>
          <!-- Page Heading -->
          <div class="group-btn py-3">
            <button class="ml-2 btn btn-info" id ="codesubmit" type="button">실행</button>
            <!-- <button class="ml-1 btn btn-light" type="button">채점</button> -->
            <% if(p_type == "S"){ %>
              <button class="float-right mr-2 btn btn-danger" type="button" data-toggle="modal" data-target="#submitModal">제출</button>
            <% } %>
            <!-- Modal -->
            <div class="modal fade" id="submitModal" tabindex="-1" aria-labelledby="submitModalLabel" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content ">
                  <div class="modal-header d-block  text-center py-5">
                    <h5 class="modal-title " id="submitModalLabel">제출하시겠습니까?</h5>
                    <!-- <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button> -->
                  </div>
                  <!-- <div class="modal-body text-center">
                    제출하시겠습니까?
                  </div> -->
                  <div class="modal-footer d-block text-center">
                    <button type="button" class="btn btn-danger" data-dismiss="modal" onclick="alert('제출되었습니다');">제출</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">취소</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <article class="result-zone-out p-3">
            <h4>실행결과</h4>
            <pre id="result">이 곳에 코드 결과가 출력됩니다.
            </pre>
          </article>


        </section>
        <!-- //실행 영역 -->
      </div>
      <!-- //Main Content -->

    </div>
    <!-- //Content Wrapper -->
  </div>
  <!-- //Page Wrapper -->

  <!-- Bootstrap core JavaScript-->
  <script src="http://wdr.ubion.co.kr/CodingExercise/vendor/jquery/jquery.min.js"></script>
  <script src="http://wdr.ubion.co.kr/CodingExercise/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Core plugin JavaScript-->
  <script src="http://wdr.ubion.co.kr/CodingExercise/vendor/jquery-easing/jquery.easing.min.js"></script>
  <!-- splitter scripts-->
  <script src="http://wdr.ubion.co.kr/CodingExercise/vendor/jquery.splitter/jquery.splitter.js"></script>
  <!-- Custom scripts -->
  <script src="http://wdr.ubion.co.kr/CodingExercise/js/main.js"></script>
</body>

</html>
