  <script>
    $(document).ready(function(){

      var editor = CodeMirror.fromTextArea(document.getElementById("code"), {
          lineNumbers: true,
          matchBrackets: true,
          theme: 'material-palenight'
      });

      $("#codesubmit").click(function () {
        var code = editor.getValue();

        var usr_id = $("#usr_id").val();

        code = code.replace("\n", "\r\n");

        param = {
          code: code,
          usr_id : usr_id
        }

        $.ajax({
          url: "<%=_prop.Api.CodeExecuteUrl%>/test",
          type: "GET",
          dataType: 'json',
          data: param,
          success: function (data) {
            var type = data.type;
            var text = data.text;
            text = text.replace(/\>/gi, "&gt;")
            text = text.replace(/\</gi, "&lt;")

            if(type == "text"){
              $("#result").html(text.replace(/\n/gi, "<br/>"));
            }
            else{
              $("#result").html("<img src='"+text+"' />");
            }

            
          }

        });
      });

      $("#fileupload").click(function () {
        
        var usr_id = $("#usr_id").val();
        var files = $("#file")[0].files;
        var file = files[0];
        var code = "";

        var filetype = [];
        filetype = file.name.split(".");

        if(filetype[1] != "csv" && filetype[1] != "txt"){
          alert("현재 CSV, TXT 타입의 파일만 업로드 가능합니다.")
          return false;
        } 

        var reader = new FileReader();
                        
        reader.onload = function(readerEvt){

            var binaryString = readerEvt.target.result;
            
            code = btoa(binaryString);

            param = {
              code: code,
              usr_id : usr_id,
              filename : file.name,
              filetype : filetype[1]
            }

            console.log(param);

            $.ajax({
              url: "<%=_prop.Api.CodeExecuteUrl%>/upload",
              type: "GET",
              dataType: 'json',
              data: param,
              success: function (data) {
                if(data){
                  alert("업로드 완료");
                }
                else{
                  alert("업로드 실패");
                }
              }

            });

        }
        reader.readAsBinaryString(file); //여기서 reader.onload 실행.

      });

    });
    
  </script>
